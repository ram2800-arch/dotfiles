#!/bin/bash
export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
STATION="$1"
ACTION="${2:-start}" # Defaults to 'start' if no second parameter is provided

case "$STATION" in
    1) NAME="Radio Mirchi"; KEY="radios.crabdance.com:8002/1"; URL="http://$KEY"; HEADER="User-Agent: Mozilla/5.0,Referer: https://www.tamilradios.com/" ;;
    2) NAME="Sun FM"; KEY="radios.crabdance.com:8002/2"; URL="http://$KEY"; HEADER="User-Agent: Mozilla/5.0,Referer: https://www.tamilradios.com/" ;;
    3) NAME="Hello FM"; KEY="radios.crabdance.com:8002/3"; URL="http://$KEY"; HEADER="User-Agent: Mozilla/5.0,Referer: https://www.tamilradios.com/" ;;
    4) NAME="Big FM"; KEY="radios.crabdance.com:8002/4"; URL="http://$KEY"; HEADER="User-Agent: Mozilla/5.0,Referer: https://www.tamilradios.com/" ;;
    5) NAME="Oli FM"; KEY="OLI968FMAAC"; URL="https://playerservices.streamtheworld.com/api/livestream-redirect/OLI968FMAAC.aac"; HEADER="" ;;
    stop) 
        pkill -f "radios.crabdance.com" > /dev/null 2>&1
        pkill -f "OLI968FMAAC" > /dev/null 2>&1
        echo "All radio streams stopped."
        exit 0 
        ;;
    *) 
        echo "Usage: radio {1|2|3|4|5|stop} [start|stop|status]"
        echo "1: Mirchi | 2: Sun FM | 3: Hello FM | 4: Big FM | 5: Oli FM"
        exit 1 
        ;;
esac

case "$ACTION" in
    start)
        # Kill any existing streams first to prevent overlapping audio
        pkill -f "radios.crabdance.com" > /dev/null 2>&1
        pkill -f "OLI968FMAAC" > /dev/null 2>&1
        
        echo "Starting $NAME..."
        if [ -n "$HEADER" ]; then
            nohup mpv --no-video --http-header-fields="$HEADER" "$URL" > /dev/null 2>&1 &
        else
            nohup mpv --no-video "$URL" > /dev/null 2>&1 &
        fi
        echo "$NAME is playing in the background."
        ;;
    stop)
        pkill -f "$KEY" > /dev/null 2>&1
        echo "$NAME stopped."
        ;;
    status)
        if pgrep -f "$KEY" > /dev/null; then
            echo "$NAME is running."
        else
            echo "$NAME is stopped."
        fi
        ;;
esac
